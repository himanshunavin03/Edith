# EDITH backend environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# Required: OpenAI API key. Kept server-side only, never sent to the browser.
OPENAI_API_KEY=

# Server port
PORT=3000

# Comma-separated list of allowed origins for CORS.
# Example for local dev with Angular default port + LAN/iPhone testing:
# ALLOWED_ORIGIN=http://localhost:4200,https://192.168.1.20:4200
ALLOWED_ORIGIN=http://localhost:4200

# OpenAI chat model used for conversation (verify current model availability
# in your OpenAI account before changing).
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI TTS model + voice, used only if the frontend requests
# server-generated speech (provider=openai). Browser SpeechSynthesis is the
# default V1 TTS path and needs none of this.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Speech-to-text model. iOS Safari has no browser SpeechRecognition API, so
# the frontend records audio and sends it here to be transcribed.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Node environment
NODE_ENV=development
